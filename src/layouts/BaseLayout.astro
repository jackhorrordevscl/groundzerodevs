---
import '../styles/global.css';
// Self-hosted fonts (latin subset covers Spanish and English). Only the weights the site uses.
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/fira-code/latin-400.css';
import '@fontsource/fira-code/latin-500.css';
// Preload the two faces used above the fold (hero heading and body text).
import jakarta800 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-800-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import { languages } from '../i18n';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';

interface Props {
  lang: 'es' | 'en';
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Every language version is listed on every page (self-reference included), with absolute URLs.
const alternates = languages.map((l) => ({ code: l.code, href: new URL(l.href, Astro.site).href }));
const defaultHref = alternates.find((a) => a.code === 'es')!.href;
const ogLocales = { es: 'es_CL', en: 'en_US' } as const;
// Cloudflare Web Analytics is injected only when the token is set at build time.
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="groundzerodevs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {alternates.filter((a) => a.code !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocales[a.code]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" as="font" type="font/woff2" href={jakarta800} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter400} crossorigin />
    {beaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      ></script>
    )}
  </head>
  <body>
    <slot />
    <WhatsAppFloat lang={lang} />
  </body>
</html>
