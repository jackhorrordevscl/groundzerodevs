---
import '../styles/global.css';
import { languages } from '../i18n';

interface Props {
  lang: 'es' | 'en';
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Every language version is listed on every page (self-reference included), with absolute URLs.
const alternates = languages.map((l) => ({ code: l.code, href: new URL(l.href, Astro.site).href }));
const defaultHref = alternates.find((a) => a.code === 'es')!.href;
const ogLocales = { es: 'es_CL', en: 'en_US' } as const;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="groundzerodevs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {alternates.filter((a) => a.code !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocales[a.code]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@700;800&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
