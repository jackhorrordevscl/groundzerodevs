---
// Case cards. Copy comes from the dictionary; URLs, hosts and images are shared (src/data/cases.ts).
import CaseThumb from './CaseThumb.astro';
import { caseMedia, caseOrder, featuredCase, magiHost, magiUrl } from '../data/cases';
import { getDictionary } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section id={t.ids.work} class="section cases" aria-labelledby={`${t.ids.work}-title`}>
  <header class="head">
    <p class="section-label">{t.cases.label}</p>
    <h2 id={`${t.ids.work}-title`}>
      {t.cases.title}
    </h2>
  </header>

  <ul class="grid">
    {
      caseOrder.map((id) => {
        const c = t.cases.items[id];
        const media = caseMedia[id];
        return (
          <li class:list={['card', { featured: id === featuredCase }]}>
            <CaseThumb lang={lang} name={c.name} src={media.image} />
            <div class="content">
              <div class="meta">
                <span class="kind">{c.kind}</span>
                <span class:list={['status', { early: id === featuredCase }]}>{c.status}</span>
              </div>
              <h3>{c.name}</h3>
              <p>{c.text}</p>
              <p class="stack">{c.stack}</p>
              <a href={media.url} target="_blank" rel="noopener noreferrer">
                {media.host} <span aria-hidden="true">↗</span>
                <span class="sr-only">{t.common.newTab}</span>
              </a>
            </div>
          </li>
        );
      })
    }
  </ul>

  <aside class="lab" aria-label={t.cases.lab.ariaLabel}>
    <p class="lab-label">{t.cases.lab.label}</p>
    <p class="lab-text">
      <b>MAGI</b> {t.cases.lab.text}
    </p>
    <a href={magiUrl} target="_blank" rel="noopener noreferrer">
      {magiHost} <span aria-hidden="true">↗</span>
      <span class="sr-only">{t.common.newTab}</span>
    </a>
  </aside>
</section>

<style>
  .cases {
    padding-block: var(--space-9) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .section-label {
    color: var(--color-ink-subtle);
  }
  h2 {
    font-size: clamp(1.75rem, 4vw, var(--text-3xl));
    letter-spacing: -0.03em;
    line-height: 1.02;
    max-width: 62.5rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-charcoal);
    color: var(--color-bone);
    min-width: 0;
  }
  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 1.375rem 1.75rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 1.2px;
  }
  .kind {
    color: var(--color-amber);
  }
  .status {
    border: 1px solid var(--color-line);
    padding: 2px var(--space-2);
  }
  .status.early {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
  h3 {
    font-size: clamp(1.75rem, 3vw, var(--text-xl));
    line-height: 1.05;
    overflow-wrap: break-word;
  }
  .content p {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-on-dark-muted);
  }
  .content .stack {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.5px;
    line-height: 1.4;
    color: var(--color-bone);
  }
  .content a {
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--color-amber);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .content a:hover {
    color: var(--color-bone);
    text-decoration: underline;
  }

  .lab {
    border: 2px dashed var(--color-charcoal);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .lab-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 1.5px;
  }
  .lab-text {
    flex: 1;
    font-size: var(--text-md);
    line-height: 1.45;
    color: var(--color-ink-muted);
  }
  .lab-text b {
    color: var(--color-charcoal);
  }
  .lab a {
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .lab a:hover {
    text-decoration: underline;
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
    /* The featured case spans the full row (stacked here; side by side from 75rem). */
    .card.featured {
      grid-column: 1 / -1;
    }
  }

  /* Two columns: the five cards after the featured one leave the last (6th child) alone, so center it. */
  @media (min-width: 48rem) and (max-width: 74.99rem) {
    .card:last-child:nth-child(even) {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc((100% - var(--space-5)) / 2);
    }
  }

  /* Wide screens: three columns keep each 16:10 capture whole but about a third smaller. A 6-column grid
     lets the featured card span all of it and the last two cards sit centered under the first three.
     The featured card goes side by side (screenshot left, text right); below 75rem its text is taller than
     the thumbnail, which would stretch and crop the capture sideways, so it stays stacked there. */
  @media (min-width: 75rem) {
    .grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .card {
      grid-column: span 2;
    }
    .card.featured {
      grid-column: 1 / -1;
      flex-direction: row;
    }
    .card:nth-child(5) {
      grid-column: 2 / span 2;
    }
    .card.featured :global(.thumb) {
      flex: 0 0 45%;
      border-bottom: 0;
      border-right: 1px dashed var(--color-dark-line);
    }
    .card.featured .content {
      justify-content: center;
      gap: var(--space-3);
      padding: var(--space-6);
    }
    .card.featured h3 {
      font-size: var(--text-2xl);
    }
  }

  @media (min-width: 64rem) {
    .lab {
      flex-direction: row;
      align-items: center;
      gap: var(--space-6);
      padding-inline: var(--space-6);
      min-height: 6.875rem;
    }
    .lab-label {
      width: 10.625rem;
      flex: none;
    }
    .lab a {
      flex: none;
    }
  }
</style>
