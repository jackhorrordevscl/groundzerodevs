---
import CaseThumb from './CaseThumb.astro';
import { caseMedia, magiHost, magiUrl } from '../data/cases';
import type { CaseId } from '../data/cases';

interface CaseCopy {
  id: CaseId;
  kind: string;
  status: string;
  featured?: boolean;
  name: string;
  text: string;
}

const cases: CaseCopy[] = [
  {
    id: 'umbral',
    kind: 'PRODUCTO PROPIO · CONSTRUIR',
    status: 'ACCESO ANTICIPADO',
    featured: true,
    name: 'Umbral',
    text: 'Fichas clínicas para psicólogos independientes en Chile. Cifrado, auditoría y normativa chilena.',
  },
  {
    id: 'morgado',
    kind: 'CLIENTE · PRESENCIA',
    status: 'EN PRODUCCIÓN',
    name: 'Morgado, Cía. & Asociados',
    text: 'Sitio corporativo de un estudio jurídico en Santiago, más la gestión de su Instagram.',
  },
  {
    id: 'journaling',
    kind: 'CLIENTE · PRESENCIA',
    status: 'EN PRODUCCIÓN',
    name: 'Journaling En Red',
    text: 'Sitio de un servicio de acompañamiento psicosocial en Santiago.',
  },
  {
    id: 'elizabeth',
    kind: 'CLIENTE · PRESENCIA',
    status: 'EN PRODUCCIÓN',
    name: 'Elizabeth Maureira, Abogada',
    text: 'Sitio profesional de una abogada en Providencia, Santiago.',
  },
];
---

<section id="casos" class="section cases" aria-labelledby="casos-title">
  <header class="head">
    <p class="section-label">02 — CASOS</p>
    <h2 id="casos-title">
      Construimos productos propios. Sabemos lo que cuesta llevarlos a producción.
    </h2>
  </header>

  <ul class="grid">
    {
      cases.map((c) => {
        const media = caseMedia[c.id];
        return (
          <li class="card">
            <CaseThumb name={c.name} src={media.image} />
            <div class="content">
              <div class="meta">
                <span class="kind">{c.kind}</span>
                <span class:list={['status', { early: c.featured }]}>{c.status}</span>
              </div>
              <h3>{c.name}</h3>
              <p>{c.text}</p>
              <a href={media.url} target="_blank" rel="noopener noreferrer">
                {media.host} <span aria-hidden="true">↗</span>
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
            </div>
          </li>
        );
      })
    }
  </ul>

  <aside class="lab" aria-label="Laboratorio">
    <p class="lab-label">LABORATORIO · I+D</p>
    <p class="lab-text">
      <b>MAGI</b> — investigación propia: una compuerta multi-agente que autoriza o bloquea acciones de
      agentes de código antes de ejecutarse.
    </p>
    <a href={magiUrl} target="_blank" rel="noopener noreferrer">
      {magiHost} <span aria-hidden="true">↗</span>
      <span class="sr-only">(se abre en una pestaña nueva)</span>
    </a>
  </aside>
</section>

<style>
  .cases {
    padding-block: var(--space-9) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .section-label {
    color: var(--color-ink-subtle);
  }
  h2 {
    font-size: clamp(1.75rem, 4vw, var(--text-3xl));
    letter-spacing: -0.03em;
    line-height: 1.02;
    max-width: 62.5rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-charcoal);
    color: var(--color-bone);
    min-width: 0;
  }
  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 1.375rem 1.75rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 1.2px;
  }
  .kind {
    color: var(--color-amber);
  }
  .status {
    border: 1px solid var(--color-line);
    padding: 2px var(--space-2);
  }
  .status.early {
    border-color: var(--color-amber);
    color: var(--color-amber);
  }
  h3 {
    font-size: clamp(1.75rem, 3vw, var(--text-xl));
    line-height: 1.05;
    overflow-wrap: break-word;
  }
  .content p {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-on-dark-muted);
  }
  .content a {
    margin-top: auto;
    padding-top: var(--space-3);
    color: var(--color-amber);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .content a:hover {
    color: var(--color-bone);
    text-decoration: underline;
  }

  .lab {
    border: 2px dashed var(--color-charcoal);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .lab-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 1.5px;
  }
  .lab-text {
    flex: 1;
    font-size: var(--text-md);
    line-height: 1.45;
    color: var(--color-ink-muted);
  }
  .lab-text b {
    color: var(--color-charcoal);
  }
  .lab a {
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .lab a:hover {
    text-decoration: underline;
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  @media (min-width: 64rem) {
    .lab {
      flex-direction: row;
      align-items: center;
      gap: var(--space-6);
      padding-inline: var(--space-6);
      min-height: 6.875rem;
    }
    .lab-label {
      width: 10.625rem;
      flex: none;
    }
    .lab a {
      flex: none;
    }
  }
</style>
