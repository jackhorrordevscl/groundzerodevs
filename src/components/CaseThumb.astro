---
// Case screenshot slot. Renders the real capture when `src` is set (task T9),
// otherwise a neutral browser-frame placeholder. It never imitates the product UI.
interface Props {
  name: string;
  src: string | null;
}

const { name, src } = Astro.props;
---

<div class="thumb">
  {
    src ? (
      <img src={src} alt={`Captura de ${name}`} width="1440" height="900" loading="lazy" decoding="async" />
    ) : (
      <div class="placeholder" aria-hidden="true">
        <div class="bar">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
        </div>
        <div class="label">[CAPTURA PENDIENTE · {name.toUpperCase()}]</div>
      </div>
    )
  }
</div>

<style>
  .thumb {
    height: 9.375rem;
    background: var(--color-dark-surface);
    border-bottom: 1px dashed var(--color-dark-line);
    overflow: hidden;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .bar {
    display: flex;
    gap: 6px;
    padding: 8px 12px;
    border-bottom: 1px dashed var(--color-dark-line);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--color-line);
  }
  .label {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-4);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 1px;
    color: var(--color-on-dark-muted);
  }
</style>
