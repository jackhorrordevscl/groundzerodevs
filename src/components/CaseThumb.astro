---
// Case screenshot slot. Renders the real capture when `src` is set (task T9),
// otherwise a neutral browser-frame placeholder. It never imitates the product UI.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getDictionary } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  name: string;
  src: ImageMetadata | null;
}

const { lang, name, src } = Astro.props;
const t = getDictionary(lang);
---

<div class="thumb">
  {
    src ? (
      <Image
        src={src}
        alt={t.cases.thumbAlt(name)}
        widths={[400, 640, 960]}
        sizes="(min-width: 1100px) 33vw, (min-width: 720px) 50vw, 100vw"
        format="webp"
        quality={80}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="placeholder" aria-hidden="true">
        <div class="bar">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
        </div>
        <div class="label">{t.cases.thumbPending(name)}</div>
      </div>
    )
  }
</div>

<style>
  .thumb {
    /* Captures are 1440x900 (16:10): show them whole instead of cropping a band. */
    aspect-ratio: 16 / 10;
    background: var(--color-dark-surface);
    border-bottom: 1px dashed var(--color-dark-line);
    overflow: hidden;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .bar {
    display: flex;
    gap: 6px;
    padding: 8px 12px;
    border-bottom: 1px dashed var(--color-dark-line);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--color-line);
  }
  .label {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-4);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 1px;
    color: var(--color-on-dark-muted);
  }
</style>
