---
// Site footer. No cookie banner: analytics will be cookieless.
import { getDictionary, languages } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<footer class="site-footer">
  <a class="brand" href={t.common.homeHref}>
    <svg class="brand-mark" viewBox="0 0 30 30" aria-hidden="true" focusable="false"><path d="M15 2 27 9v12l-12 7-12-7V9Z" fill="currentColor" /><path d="M15 2v26M3 9l24 12" stroke="#fff" stroke-width="1.5" stroke-opacity=".55" /></svg>
    <span class="brand-name">groundzerodevs</span>
  </a>
  <p class="muted">Chile · LATAM</p>
  <a class="muted mail" href="mailto:contacto@groundzerodevs.com">contacto@groundzerodevs.com</a>
  <p class="lang">
    {
      languages.map((l, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> | </span>}
          {l.code === lang ? (
            <b aria-current="true">
              <span class="sr-only">{l.name}, </span>
              {l.label}
            </b>
          ) : (
            <a href={l.href} lang={l.code} hreflang={l.code}>
              {l.label}
            </a>
          )}
        </>
      ))
    }
  </p>
  <p class="muted">© 2026 groundzerodevs</p>
</footer>

<style>
  .site-footer {
    padding: var(--space-8) var(--space-5);
    background: var(--color-ink);
    color: var(--color-surface);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    font-size: 0.875rem;
  }
  .site-footer a {
    color: var(--color-surface);
  }
  .site-footer a:hover {
    color: var(--color-accent-soft);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    text-decoration: none;
  }
  .brand-mark {
    width: 1.875rem;
    height: 1.875rem;
    flex-shrink: 0;
    /* The lighter accent keeps the mark visible on the ink footer. */
    color: var(--color-accent-soft);
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
  }
  .muted,
  .site-footer a.muted {
    color: var(--color-on-dark-muted);
  }
  .mail {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    overflow-wrap: anywhere;
  }
  /* 44x44 CSS px targets (WCAG 2.5.5 AAA, mobile). */
  .lang a,
  .lang b {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
  }
  .lang b {
    color: var(--color-accent-soft);
  }
  .lang a {
    text-decoration: none;
  }
  .site-footer a.muted:hover {
    color: var(--color-accent-soft);
  }

  @media (min-width: 40rem) {
    .site-footer {
      padding-inline: var(--pad-x);
    }
  }

  @media (min-width: 64rem) {
    .site-footer {
      flex-wrap: nowrap;
      min-height: 10rem;
      padding-block: 0;
    }
  }
</style>
