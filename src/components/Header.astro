---
// Site header. Copy comes from the dictionary for `lang`; nav anchors match the section ids on that page.
import { getDictionary, languages } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<header class="site-header">
  <a class="brand" href={t.common.homeHref} aria-label={t.common.homeLabel}>
    <span class="brand-mark" aria-hidden="true">0,0</span>
    <span class="brand-name">groundzerodevs</span>
  </a>
  <nav class="nav" aria-label={t.header.navLabel}>
    <a href={`#${t.ids.services}`}>{t.header.nav.services}</a>
    <a href={`#${t.ids.work}`}>{t.header.nav.work}</a>
    <a href={`#${t.ids.sustain}`}>{t.header.nav.sustain}</a>
    <a href={`#${t.ids.process}`}>{t.header.nav.process}</a>
    <a href={`#${t.ids.contact}`}>{t.header.nav.contact}</a>
  </nav>
  <div class="tools">
    <span class="lang">
      {
        languages.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> | </span>}
            {l.code === lang ? (
              <b aria-current="true">
                <span class="sr-only">{l.name}, </span>
                {l.label}
              </b>
            ) : (
              <a href={l.href} lang={l.code} hreflang={l.code}>
                {l.label}
              </a>
            )}
          </>
        ))
      }
    </span>
    <a class="wa" href="https://wa.me/56956039666">WhatsApp</a>
  </div>
</header>

<style>
  .site-header {
    min-height: 5.5rem;
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }
  .brand-mark {
    width: 2.25rem;
    height: 2.25rem;
    background: var(--color-amber);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.5px;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-weight: 500;
    order: 3;
    width: 100%;
  }
  .nav a {
    text-decoration: none;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }
  .lang a {
    text-decoration: none;
  }
  .wa {
    background: var(--color-charcoal);
    color: var(--color-bone);
    text-decoration: none;
    font-weight: 600;
    padding: var(--space-3) 1.25rem;
  }
  .wa:hover {
    color: var(--color-bone);
    background: var(--color-ink-muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .site-header {
      padding-inline: var(--gutter);
    }
  }

  @media (min-width: 64rem) {
    .site-header {
      flex-wrap: nowrap;
      padding-block: 0;
    }
    .nav {
      order: 0;
      width: auto;
    }
  }
</style>
