---
// Hero with blueprint details (grid, axes, 0,0 origin, three pillars, Santiago coordinate).
import { getDictionary } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="copy">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 id="hero-title">
      {t.hero.title} <span class="mark">{t.hero.titleMark}</span>
    </h1>
    <p class="lead">
      {t.hero.lead}
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="https://wa.me/56956039666">{t.hero.ctaPrimary}</a>
      <a class="btn btn-secondary" href={`#${t.ids.work}`}>{t.hero.ctaSecondary}</a>
    </div>
  </div>

  <figure class="blueprint">
    <div class="plane">
      <span class="axis axis-x" aria-hidden="true"></span>
      <span class="axis axis-y" aria-hidden="true"></span>
      <span class="origin" aria-hidden="true"></span>
      <span class="origin-label" aria-hidden="true">0,0</span>
      <ul class="pillars" aria-label={t.hero.pillarsLabel}>
        <li class="pillar pillar-1"><span aria-hidden="true">01 </span>{t.hero.pillars[0]}</li>
        <li class="pillar pillar-2"><span aria-hidden="true">02 </span>{t.hero.pillars[1]}</li>
        <li class="pillar pillar-3"><span aria-hidden="true">03 </span>{t.hero.pillars[2]}</li>
      </ul>
      <span class="tick tick-x" aria-hidden="true">x →</span>
      <span class="tick tick-y" aria-hidden="true">y ↓</span>
      <span class="coord">33.4489° S · 70.6693° W</span>
    </div>
    <figcaption>{t.hero.caption}</figcaption>
  </figure>
</section>

<style>
  .hero {
    padding: var(--space-8) var(--space-5) var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-width: 0;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 1.5px;
    color: var(--color-ink-subtle);
  }
  h1 {
    font-size: clamp(2.5rem, 10vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.038em;
    overflow-wrap: break-word;
  }
  .mark {
    background: var(--color-amber);
    padding: 0 var(--space-3);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .lead {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 41.25rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .btn {
    text-decoration: none;
    font-weight: 600;
    font-size: 1.125rem;
  }
  .btn-primary {
    background: var(--color-charcoal);
    color: var(--color-bone);
    padding: 1.125rem var(--space-6);
  }
  .btn-primary:hover {
    color: var(--color-bone);
    background: var(--color-ink-muted);
  }
  .btn-secondary {
    border: 2px solid var(--color-charcoal);
    padding: 1rem 1.875rem;
  }

  /* Blueprint figure: all positions are percentages of the 420x400 design plane. */
  .blueprint {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: 26.25rem;
  }
  .plane {
    position: relative;
    aspect-ratio: 420 / 400;
    border: 1px solid var(--color-charcoal);
    background-color: var(--color-bone);
    background-image:
      linear-gradient(rgba(11, 14, 17, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(11, 14, 17, 0.1) 1px, transparent 1px);
    background-size: 10% 10%;
    font-family: var(--font-mono);
  }
  .axis {
    position: absolute;
    background: var(--color-charcoal);
  }
  .axis-x {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }
  .axis-y {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }
  .origin {
    position: absolute;
    left: calc(50% - 10px);
    top: calc(50% - 10px);
    width: 20px;
    height: 20px;
    border: 2px solid var(--color-charcoal);
    background: var(--color-amber);
  }
  .origin-label {
    position: absolute;
    left: 54.5%;
    top: 42%;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pillar {
    position: absolute;
    border: 1px solid var(--color-charcoal);
    background: var(--color-bone);
    padding: var(--space-2) var(--space-3);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .pillar-1 {
    left: 5.7%;
    top: 7%;
  }
  .pillar-2 {
    left: 52.4%;
    top: 26%;
  }
  .pillar-3 {
    left: 22.9%;
    top: 75%;
    background: var(--color-amber);
  }
  .tick,
  .coord {
    position: absolute;
    font-size: var(--text-xs);
    color: var(--color-ink-subtle);
  }
  .tick-x {
    right: 3%;
    top: calc(50% + 6px);
  }
  .tick-y {
    left: 51.7%;
    bottom: 10px;
  }
  .coord {
    left: 3.3%;
    bottom: 10px;
  }
  figcaption {
    font-size: var(--text-base);
    line-height: 1.4;
    max-width: 21.25rem;
  }

  @media (max-width: 39.99rem) {
    .tick-y {
      bottom: 30px;
    }
    .pillar-3 {
      top: 68%;
    }
  }

  @media (min-width: 40rem) {
    .hero {
      padding-inline: var(--gutter);
    }
  }

  @media (min-width: 68.75rem) {
    .hero {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-8);
      padding-top: var(--space-8);
    }
    .copy {
      flex: 1;
    }
    /* Left column = viewport - 2*64px gutter - 56px gap - 420px figure. */
    h1 {
      font-size: clamp(3.5rem, calc((100vw - 604px) / 8), 6.5rem);
    }
    .blueprint {
      flex: none;
      width: 26.25rem;
      margin-top: var(--space-2);
    }
  }
</style>
